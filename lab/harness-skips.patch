+bool SpirvDeclaresCapability(const std::vector<u32> &spirv, u32 capability) {
+  constexpr size_t kFirstInstruction = 5;
+  for (size_t i = kFirstInstruction; i < spirv.size();) {
+    const u32 word_count = spirv[i] >> 16u;
+    if (word_count == 0) {
+      break;
+    }
+    if ((spirv[i] & 0xffffu) == spv::OpCapability && word_count >= 2 && i + 1 < spirv.size() &&
+        spirv[i + 1] == capability) {
+      return true;
+    }
+    i += word_count;
+  }
+  return false;
+}
